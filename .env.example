# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env는 실제 경로/비밀번호가 담기므로 git에 커밋하지 않습니다.

# 컨테이너의 /home/dev 를 bind mount할 NAS 경로
# (Claude Code 로그인 정보, bash history, tmux 설정 등이 저장됨)
DEV_HOME_PATH=/volume1/docker/claude-code-dev/home

# 컨테이너의 /etc/ssh/host_keys 를 bind mount할 NAS 경로
# (SSH 호스트 키만 저장. sshd_config 등은 이미지에 그대로 둬야 하므로
#  /etc/ssh 전체가 아니라 host_keys 하위 디렉토리만 마운트한다)
# (재배포해도 SSH 지문이 바뀌지 않도록 유지)
DEV_SSH_HOSTKEYS_PATH=/volume1/docker/claude-code-dev/ssh-host-keys

# dev 계정 sudo/로그인 비밀번호.
# 비워두면 컨테이너 최초 실행 시 무작위 비밀번호가 생성되어
# `docker logs claude-code-dev` 와 컨테이너 내부 /home/dev/.initial_password 에 남습니다.
DEV_PASSWORD=

# 접속 포트 (필요 시 변경)
SSH_PORT=2222
TTYD_PORT=7681

# dev 계정의 UID/GID. 이미지 빌드 시 고정되며(useradd -u/-g), 재빌드해도
# 값이 흔들리지 않는다. bind mount한 NAS 경로의 파일 소유권을 특정 UID/GID와
# 맞추고 싶을 때만 바꾸면 되고, 대부분은 기본값 1000 그대로 두면 된다.
DEV_UID=1000
DEV_GID=1000
