# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env는 실제 경로/비밀번호가 담기므로 git에 커밋하지 않습니다.

# 컨테이너의 /home/dev 를 bind mount할 NAS 경로
# (Claude Code 로그인 정보, bash history, tmux 설정 등이 저장됨)
DEV_HOME_PATH=/volume1/docker/claude-code-docker/home

# 컨테이너의 /etc/ssh/host_keys 를 bind mount할 NAS 경로
# (SSH 호스트 키만 저장. sshd_config 등은 이미지에 그대로 둬야 하므로
#  /etc/ssh 전체가 아니라 host_keys 하위 디렉토리만 마운트한다)
# (재배포해도 SSH 지문이 바뀌지 않도록 유지)
DEV_SSH_HOSTKEYS_PATH=/volume1/docker/claude-code-docker/ssh-host-keys

# dev 계정 sudo/로그인 비밀번호.
# 비워두면 컨테이너 최초 실행 시 무작위 비밀번호가 생성되어
# `docker logs claude-code-docker` 와 컨테이너 내부
# /var/lib/claude-code-docker/.initial_password 에 남습니다.
DEV_PASSWORD=

# entrypoint가 dev 계정의 평문 비밀번호(.initial_password)를 저장해두는
# NAS 경로. /home/dev(DEV_HOME_PATH) 안이 아니라 완전히 별도 경로여야
# 한다 — 그 경로는 filebrowser가 그대로 서빙하는 트리라서, 안에 두면
# filebrowser로 접속한 사람이 SSH/sudo 비밀번호까지 그대로 열어볼 수 있게
# 된다.
DEV_SECRETS_PATH=/volume1/docker/claude-code-docker/secrets

# 접속 포트 (필요 시 변경)
SSH_PORT=2222
TTYD_PORT=7681
FILEBROWSER_PORT=8080

# filebrowser(웹 파일 매니저)의 설정/계정 DB를 bind mount할 NAS 경로.
# /home/dev(서빙 대상) 안이 아니라 완전히 별도 경로여야 한다 — 안 그러면
# 파일 매니저 자신의 인증 DB가 자기가 서빙하는 트리 안에 놓이게 된다.
FILEBROWSER_DATA_PATH=/volume1/docker/claude-code-docker/filebrowser

# dev 계정의 UID/GID. 이미지 빌드 시 고정되며(useradd -u/-g), 재빌드해도
# 값이 흔들리지 않는다. bind mount한 NAS 경로의 파일 소유권을 특정 UID/GID와
# 맞추고 싶을 때만 바꾸면 되고, 대부분은 기본값 1000 그대로 두면 된다.
DEV_UID=1000
DEV_GID=1000

# 컨테이너 hostname. 지정하지 않으면 Docker가 컨테이너 ID를 hostname으로
# 써서 셸 프롬프트에 임의의 문자열이 뜬다.
DEV_HOSTNAME=claude-code-docker

# 설치할 @anthropic-ai/claude-code 버전.
# 기본값 latest면 빌드 시점의 최신 버전이 설치되고 자동 업데이트 기능도
# 그대로 켜져 있다. 특정 버전(예: 2.1.112)으로 고정하면 그 버전이 설치되고
# entrypoint가 자동 업데이트를 꺼서 고정된 버전이 유지되도록 한다.
CLAUDE_CODE_VERSION=latest
